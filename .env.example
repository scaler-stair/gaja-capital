# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.

# Anthropic API key (console.anthropic.com > API keys). Used for report
# extraction, the AI assistant and the compiled board brief.
ANTHROPIC_API_KEY=

# Neon Postgres connection string (Neon console > Connect > copy the
# connection string). Stores users, reports, findings and the PDFs.
DATABASE_URL=

# Signs login sessions. Any random string of 32+ characters:
#   openssl rand -hex 32
SESSION_SECRET=

# First super admin, created by `npm run setup`; they sign in with this email.
# Leave the password empty and setup generates a strong one and prints it once.
SUPERADMIN_EMAIL=superadmin@gajacapital.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=

# Total user accounts allowed on the dashboard, super admins included.
MAX_USERS=5

# Optional model settings. Defaults: Claude Sonnet 5.5, medium effort.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# EXTRACTION_EFFORT=medium
# CHAT_EFFORT=medium
